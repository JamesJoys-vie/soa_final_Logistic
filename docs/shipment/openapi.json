  "components": {
    "schemas": {
      "ApprovalType": {
        "type": "string",
        "enum": [
          "MANUAL",
          "TIMEOUT"
        ],
        "title": "ApprovalType"
      },
      "AssignmentIn": {
        "properties": {
          "vehicle_id": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "exclusiveMinimum": 0.0,
            "title": "Vehicle Id"
          },
          "destination": {
            "type": "string",
            "title": "Destination",
            "description": "Vị trí đích"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/LineSchema"
            },
            "type": "array",
            "minItems": 1,
            "title": "Lines"
          }
        },
        "type": "object",
        "required": [
          "vehicle_id",
          "destination",
          "lines"
        ],
        "title": "AssignmentIn"
      },
      "AssignmentOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "vehicle_id": {
            "type": "integer",
            "title": "Vehicle Id"
          },
          "plate": {
            "type": "string",
            "title": "Plate"
          },
          "destination": {
            "type": "string",
            "title": "Destination"
          },
          "created_by": {
            "type": "string",
            "title": "Created By"
          },
          "creator_role": {
            "$ref": "#/components/schemas/Role"
          },
          "status": {
            "$ref": "#/components/schemas/AssignmentStatus"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "server_time": {
            "type": "string",
            "title": "Server Time",
            "description": "Giờ server, để frontend đếm ngược không phụ thuộc đồng hồ máy người dùng"
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Decision"
              },
              {
                "type": "null"
              }
            ],
            "description": "Khác null khi status = PENDING: đã quyết định, đang chờ Inventory"
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided By"
          },
          "decided_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          },
          "approval_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApprovalType"
              },
              {
                "type": "null"
              }
            ]
